{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Valores del chart agroeco-etl",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "etl", "postgres", "cronjob", "cargaInicial", "ejecucion", "resources", "volumenes", "alertas"],
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": {
          "type": "string",
          "description": "Vacío = appVersion. Nunca latest.",
          "not": { "const": "latest" }
        },
        "digest": {
          "type": "string",
          "description": "Vacío o sha256: con 64 caracteres hexadecimales.",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "pullPolicy": { "enum": ["IfNotPresent", "Always", "Never"] }
      }
    },
    "etl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nivelLog"],
      "properties": {
        "nivelLog": { "enum": ["DEBUG", "INFO", "WARNING", "ERROR"] }
      }
    },
    "postgres": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "host", "port", "database", "credentialsSecret", "tls"],
      "properties": {
        "enabled": { "type": "boolean" },
        "host": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "database": { "type": "string", "minLength": 1 },
        "credentialsSecret": { "type": "string", "minLength": 1 },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sslmode", "caSecret"],
          "properties": {
            "sslmode": {
              "description": "Sin disable/allow/prefer: la conexión cifrada la exige el cliente.",
              "enum": ["require", "verify-ca", "verify-full"]
            },
            "caSecret": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "cronjob": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schedule", "timeZone", "suspend", "concurrencyPolicy", "startingDeadlineSeconds", "successfulJobsHistoryLimit", "failedJobsHistoryLimit"],
      "properties": {
        "schedule": { "type": "string", "minLength": 9 },
        "timeZone": { "type": "string", "minLength": 1 },
        "suspend": { "type": "boolean" },
        "concurrencyPolicy": { "enum": ["Forbid", "Replace", "Allow"] },
        "startingDeadlineSeconds": { "type": "integer", "minimum": 10 },
        "successfulJobsHistoryLimit": { "type": "integer", "minimum": 0 },
        "failedJobsHistoryLimit": { "type": "integer", "minimum": 0 }
      }
    },
    "cargaInicial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "ttlSecondsAfterFinished"],
      "properties": {
        "enabled": { "type": "boolean" },
        "ttlSecondsAfterFinished": { "type": "integer", "minimum": 0 }
      }
    },
    "ejecucion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backoffLimit", "activeDeadlineSeconds"],
      "properties": {
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 60 }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": {
          "type": "object",
          "required": ["cpu", "memory"],
          "properties": {
            "cpu": { "type": ["string", "number"] },
            "memory": { "type": "string" }
          }
        },
        "limits": {
          "type": "object",
          "required": ["memory"],
          "properties": {
            "memory": { "type": "string" }
          }
        }
      }
    },
    "volumenes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["datos", "tmp"],
      "properties": {
        "datos": { "type": "string" },
        "tmp": { "type": "string" }
      }
    },
    "alertas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Crea la PrometheusRule del ETL. Requiere el CRD de kube-prometheus-stack."
        }
      }
    }
  }
}
